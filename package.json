{
  "name": "score-reader",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "test": "jest",
    "check:contrast": "jest src/ui/theme/__tests__/contrast.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test",
    "check:16kb": "bash scripts/check-16kb-alignment.sh"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^18.2.5",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@shopify/flash-list": "^2.3.2",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-freeze": "^1.0.4",
    "react-i18next": "^17.0.15",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@phosphor-icons/core": "^2.1.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "eslint-plugin-i18next": "^6.1.5",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "ScoreReaderSpecs",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.alphastack.scorereader.specs"
    }
  },
  "op-sqlite": {
    "fts5": true
  }
}
